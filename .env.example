# Bu faylni .env nomi bilan nusxalang: cp .env.example .env
# Va qiymatlarni to'ldiring.

# BotFather bergan token
BOT_TOKEN=123456:ABC-your-bot-token
# Bot username (@ belgisiz)
BOT_USERNAME=your_bot

# Kamida 32 belgi. Yaratish: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=
# 2-kodni hisoblash uchun MAXFIY kalit (sayt va bot bir xil kalitdan foydalanadi). Hech kimga bermang.
CODE_SECRET=

# 1 bo'lsa: bot foydalanuvchidan telefon raqamini ham tasdiqlashni so'raydi
# va u saytda kiritilgan raqam bilan bir xil bo'lishi shart.
REQUIRE_PHONE_MATCH=0

# HTTPS ortida ishlaganda 1 qiling (nginx/Caddy bilan)
COOKIE_SECURE=0
TRUST_PROXY=0

DB_PATH=data/app.db

# Administratorlar (telefon raqamlari, vergul bilan ajratiladi). Ular /admin paneliga kira oladi.
# Avval shu raqam bilan saytdan ro'yxatdan o'ting.
ADMIN_PHONES=+998901234567

# Mavzu testidan o'tish foizi (diagnostikada ham "yaxshi biladi" chegarasi)
PASS_PERCENT=60
